{
  "name": "poteto-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lauren Tan's pstack methodology as a PI.dev package: skills, playbooks, local subagent roles, and a routing extension",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extension/pstack.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "files": [
    "extension/",
    "skills/",
    "agents/",
    "scripts/",
    "README.md",
    "LICENSE",
    "PI-DELTA.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "rm -rf skills/poteto-mode/scripts/node_modules"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/bun": "latest",
    "typescript": "latest",
    "typebox": "1.3.7"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "agents",
    "workflow"
  ]
}
